# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Svix API base. Override only when using self-hosted Svix.
SVIX_API_BASE=https://api.svix.com

# Svix API key (Svix dashboard -> Settings -> API Keys).
SVIX_API_KEY=

# Svix application ID or UID. Create one per Ory project; consumers subscribe
# to this application by event type and an optional filter.
SVIX_APP_ID=

# Port the handler listens on.
PORT=3000
