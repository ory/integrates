# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Segment workspace write key (Segment dashboard -> Sources -> Settings -> API Keys).
# Used as the username in HTTP Basic auth; password is empty.
SEGMENT_WRITE_KEY=

# Segment API base. Override only for testing or to target a regional endpoint.
SEGMENT_API_BASE=https://api.segment.io/v1

# Port the handler listens on.
PORT=3000
