# Ory Network SDK URL or self-hosted Kratos URL.
# Examples:
#   Ory Network: https://<project-slug>.projects.oryapis.com
#   Self-hosted Kratos: http://kratos.kratos.svc.cluster.local:4433
ORY_SDK_URL=

# Comma-separated paths that should pass through without a session.
# Exact match or prefix match with a trailing slash (so /health doesn't
# accidentally allow /healthadmin).
ALLOWED_PATHS=/health

# Optional: when set, the service returns 302 to this URL on missing/invalid
# session, preserving the originally requested path in ?return_to=...
# Leave blank to return 401 instead (better for API gateways serving SPAs/APIs).
LOGIN_REDIRECT_URL=

# Port the ForwardAuth service listens on. Default 4181 matches the example
# Traefik dynamic config.
PORT=4181
