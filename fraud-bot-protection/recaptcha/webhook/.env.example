# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# reCAPTCHA secret key (Google reCAPTCHA admin console -> Settings -> Secret Key).
RECAPTCHA_SECRET_KEY=

# reCAPTCHA version. Set v2 to skip score/action checks; default v3.
RECAPTCHA_VERSION=v3

# v3 score threshold (0.0 to 1.0). Tokens below this are rejected.
RECAPTCHA_SCORE_THRESHOLD=0.5

# Optional v3 action match. When set, the token's action must equal this string.
# Leave blank to skip action matching.
RECAPTCHA_EXPECTED_ACTION=

# Port the handler listens on.
PORT=3000
