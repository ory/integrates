# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Castle API secret (Castle dashboard -> Configuration -> General -> API Secret).
# Used as the password in HTTP Basic auth (username is empty).
CASTLE_API_SECRET=

# Castle Risk API base. Override only for testing.
CASTLE_API_BASE=https://api.castle.io

# Risk score thresholds (0.0 to 1.0). Tune per traffic profile.
CASTLE_CHALLENGE_THRESHOLD=0.6
CASTLE_DENY_THRESHOLD=0.9

# Port the handler listens on.
PORT=3000
