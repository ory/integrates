# BambooHR company subdomain (the "<company>" piece in https://<company>.bamboohr.com).
BAMBOOHR_COMPANY=

# BambooHR API key. Generate at https://<company>.bamboohr.com/settings/permissions/api.php
BAMBOOHR_API_KEY=

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
