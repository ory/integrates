# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Zendesk Admin Center -> Apps and Integrations -> APIs -> Zendesk API.
# ZENDESK_EMAIL is the admin user whose API token authenticates the calls.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Ory Network SDK URL (e.g. https://<project-slug>.projects.oryapis.com).
ORY_SDK_URL=

# Ory admin API key with identity read scope (for the sidebar lookup).
ORY_ADMIN_API_KEY=

# Shared secret between the Zendesk sidebar app and this handler
# (X-Zendesk-Secret header value). Distinct from ORY_WEBHOOK_SECRET so a leak
# of one credential doesn't grant the other surface's privileges.
ZENDESK_SIDEBAR_SECRET=

# Port the handler listens on.
PORT=3000
