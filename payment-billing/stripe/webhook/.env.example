# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Stripe secret key (Stripe dashboard -> Developers -> API keys).
# Use sk_test_... for test mode and sk_live_... for production.
STRIPE_SECRET_KEY=

# Stripe API version pin. Update intentionally when migrating between versions.
STRIPE_API_VERSION=2025-02-24.acacia

# Port the handler listens on.
PORT=3000
