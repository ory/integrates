# Shared secret Ory sends in the X-Webhook-Secret header.
ORY_WEBHOOK_SECRET=
# Ory project URL, for example https://<project-slug>.projects.oryapis.com
ORY_SDK_URL=
# Ory project API key for the Admin API.
ORY_ADMIN_API_KEY=
# Stripe secret key (sk_live_... or sk_test_...).
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-02-24.acacia
PORT=3000
