# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Pipedrive API base. Override only for region-specific or sandbox tenants.
PIPEDRIVE_API_BASE=https://api.pipedrive.com/v1

# Pipedrive personal API token (Pipedrive -> Settings -> Personal preferences -> API).
PIPEDRIVE_API_TOKEN=

# Port the handler listens on.
PORT=3000
