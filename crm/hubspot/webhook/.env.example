# HubSpot private app token: HubSpot → Settings → Integrations → Private Apps → Create
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value)
ORY_WEBHOOK_SECRET=

# Port the handler listens on
PORT=3000
