# Dynamics 365 environment URL — your org's Dataverse endpoint.
# Form: https://<org>.crm.dynamics.com  (or .crm4. / .crm9. etc. by region)
DYNAMICS_RESOURCE_URL=https://your-org.crm.dynamics.com

# Microsoft Entra ID (Azure AD) tenant + app registration that owns the Dataverse permission.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
