# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Zoho OAuth2 client credentials (Zoho API Console).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Long-lived refresh token. Generate via the standard Zoho OAuth code flow once;
# see the docs page for the one-time authorization walkthrough.
ZOHO_REFRESH_TOKEN=

# Region-specific Zoho hosts:
#   US: ZOHO_API_BASE_URL=https://www.zohoapis.com/crm/v2  ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
#   EU: ZOHO_API_BASE_URL=https://www.zohoapis.eu/crm/v2   ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
#   IN: ZOHO_API_BASE_URL=https://www.zohoapis.in/crm/v2   ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.com/crm/v2
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Port the handler listens on.
PORT=3000
