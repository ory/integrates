# Telegram bot token, obtained from @BotFather. The widget HMAC is signed with
# SHA256(bot_token), so this is the secret that authenticates the widget data.
TELEGRAM_BOT_TOKEN=

# Maximum age of a widget payload, in seconds. Telegram recommends 86400 (24h);
# tighten to 600s (10 min) for stricter sessions.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Shared secret your application sends in X-Webhook-Secret when it forwards the
# Telegram widget payload to this handler.
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
