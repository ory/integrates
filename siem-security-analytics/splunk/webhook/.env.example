# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Splunk HEC endpoint root and token.
# URL format: https://<your-splunk-host>:8088 (no trailing slash; handler
# appends /services/collector/event).
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# Splunk routing — adjust to your indexer setup.
SPLUNK_INDEX=ory
SPLUNK_SOURCE=ory:actions
SPLUNK_SOURCETYPE=ory:auth
SPLUNK_HOST=ory-network

# Port the handler listens on.
PORT=3000
