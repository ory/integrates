# Duo API host — provided in the Duo Admin Panel after creating an Auth API integration.
# Form: api-XXXXXXXX.duosecurity.com
DUO_API_HOST=

# Duo Auth API integration key + secret key.
DUO_INTEGRATION_KEY=
DUO_SECRET_KEY=

# Push challenge poll deadline (seconds). Duo push sessions expire after ~60s by default.
DUO_POLL_DEADLINE_SECONDS=45

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
