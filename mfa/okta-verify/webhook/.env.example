# Okta org base URL — e.g. https://your-org.okta.com
OKTA_ORG_URL=

# Okta API token (SSWS). Generate under Security → API → Tokens.
# Token must have permission to read user factors and verify push factors.
OKTA_API_TOKEN=

# Push challenge poll deadline (seconds). Okta Verify push expires after ~5 min;
# tighten to your UX expectation (default 60s).
OKTA_POLL_DEADLINE_SECONDS=60

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
