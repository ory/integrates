# Okta org base URL — e.g. https://your-org.okta.com
OKTA_ORG_URL=

# Okta API token (SSWS). Generate under Security → API → Tokens.
# Token must have permission to read user factors and verify them.
OKTA_API_TOKEN=

# Set to true to let users without an enrolled Okta Verify factor sign in.
# Unenrolled users are blocked by default.
OKTA_ALLOW_UNENROLLED=false

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
