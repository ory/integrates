# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Ory Network admin URL + admin API key with identity read/write scope.
KRATOS_ADMIN_URL=
ORY_API_KEY=

# Prove API server URL. Default points at UAT; override to production when ready.
PROVE_SERVER_URL=https://platform.uat.proveapis.com

# Prove API credentials (Prove portal -> Settings -> API keys).
PROVE_CLIENT_ID=
PROVE_CLIENT_SECRET=

# Port the handler listens on.
PORT=3000
