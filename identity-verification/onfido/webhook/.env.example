# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Ory Network admin URL + admin API key with identity read/write scope.
KRATOS_ADMIN_URL=
ORY_API_KEY=

# Onfido API token (server-side) and the regional datacenter:
#   EU = https://api.eu.onfido.com
#   US = https://api.us.onfido.com
#   CA = https://api.ca.onfido.com
ONFIDO_API_TOKEN=
ONFIDO_REGION=EU

# Onfido Studio workflow ID (the verification workflow to run).
ONFIDO_WORKFLOW_ID=

# Onfido webhook signing token (Onfido admin -> Webhooks -> Tokens).
# Leave blank to disable the /onfido/callback endpoint (it will return 503).
ONFIDO_WEBHOOK_TOKEN=

# Port the handler listens on.
PORT=3000
