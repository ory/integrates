# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Ory Network admin URL + admin API key with identity read/write scope.
KRATOS_ADMIN_URL=
ORY_API_KEY=

# Persona API base + API key + inquiry template + inquiry type.
PERSONA_API_BASE=https://api.withpersona.com/api/v1
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_INQUIRY_TYPE=hosted-embedded

# Persona webhook signing secret (Persona Dashboard -> Settings -> Webhooks).
# Leave blank to disable /persona/callback (returns 503).
PERSONA_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
