# Equifax API base URL (sandbox or production — set per environment).
EQUIFAX_API_BASE=https://api.sandbox.equifax.com

# Equifax OAuth 2.0 client credentials (client_credentials grant).
EQUIFAX_CLIENT_ID=
EQUIFAX_CLIENT_SECRET=

# Equifax product / scope identifier — varies by Equifax product (e.g., usca-prsl-vfy).
EQUIFAX_SCOPE=

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
