# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Ory Network admin URL and admin API key (identity read/write scope).
KRATOS_ADMIN_URL=
ORY_API_KEY=

# LexisNexis InstantID Basic-auth credentials + tenant config.
LEXISNEXIS_USERNAME=
LEXISNEXIS_PASSWORD=
LEXISNEXIS_API_URL=
LEXISNEXIS_ORG_ID=

# Thresholds applied to the score response. NAS/NAP are 0-999 in the API;
# normalized to 0-100 before threshold comparison. CVI is 0-100 directly.
INSTANTID_NAS_THRESHOLD=50
INSTANTID_NAP_THRESHOLD=50
INSTANTID_CVI_THRESHOLD=50

# Port the handler listens on.
PORT=3000
