# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# LexisNexis InstantID Basic-auth credentials + tenant config.
LEXISNEXIS_USERNAME=
LEXISNEXIS_PASSWORD=
LEXISNEXIS_API_URL=
LEXISNEXIS_ORG_ID=

# Required. Minimum scores to pass, on the scales InstantID returns:
# NAS and NAP summaries are 0-12, CVI is 0-50. Set them from your
# LexisNexis risk policy; the handler exits when any is missing.
INSTANTID_NAS_THRESHOLD=
INSTANTID_NAP_THRESHOLD=
INSTANTID_CVI_THRESHOLD=

# Port the handler listens on.
PORT=3000
