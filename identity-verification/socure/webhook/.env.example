# Socure API base URL.
SOCURE_API_BASE=https://api.socure.com

# Socure SDK key (server-side). Generated under Socure Admin → API Keys.
SOCURE_API_KEY=

# Comma-separated list of Socure ID+ modules to run, e.g. "kyc,fraud,phonerisk".
SOCURE_MODULES=kyc,fraud

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Shared secret Socure signs its async result callbacks with.
# Configure this in Socure Admin → Webhooks; we verify the HMAC on /socure/results-callback.
SOCURE_CALLBACK_SECRET=

# Port the handler listens on.
PORT=3000
