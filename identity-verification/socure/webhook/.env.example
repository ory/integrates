# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Socure API base URL.
SOCURE_API_BASE=https://api.socure.com

# Socure SDK key (server-side). Generated under Socure Admin -> API Keys.
SOCURE_API_KEY=

# Comma-separated list of Socure ID+ modules to run, e.g. "kyc,fraud,phonerisk".
SOCURE_MODULES=kyc,fraud

# Shared secret Socure signs its async result callbacks with.
# Configure this in Socure Admin -> Webhooks; the handler verifies the HMAC
# on /socure/results-callback. Leave blank to disable the callback endpoint.
SOCURE_CALLBACK_SECRET=

# Optional: Ory Network SDK URL + admin API key so the async callback can
# write the final decision back to the identity's metadata_public.
# Leave both blank to log-only.
ORY_SDK_URL=
ORY_ADMIN_API_KEY=

# Port the handler listens on.
PORT=3000
