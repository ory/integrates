# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Ory Network admin URL (e.g. https://<project-slug>.projects.oryapis.com).
KRATOS_ADMIN_URL=

# Ory admin API key with identity read/write scope.
ORY_API_KEY=

# Jumio OAuth2 token endpoint and API base. Datacenter-specific:
#   US: https://auth.amer-1.jumio.ai/oauth2/token   and  https://api.amer-1.jumio.ai/api/v1
#   EU: https://auth.emea-1.jumio.ai/oauth2/token   and  https://api.emea-1.jumio.ai/api/v1
JUMIO_AUTH_URL=
JUMIO_API_BASE_URL=

# Jumio OAuth2 client credentials.
JUMIO_CLIENT_ID=
JUMIO_CLIENT_SECRET=

# Jumio workflow definition key for the verification flow you want to run.
# Default 10011 = IDIV (ID + Selfie + Face Match). Override per environment.
JUMIO_WORKFLOW_KEY=10011

# Shared secret Jumio signs callbacks with (configure in Jumio Workflow Callbacks).
# Leave blank to disable /jumio/callback (returns 503).
JUMIO_CALLBACK_SECRET=

# Port the handler listens on.
PORT=3000
