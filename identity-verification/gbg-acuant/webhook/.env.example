# GBG / Acuant API base URL — your dedicated tenant URL.
GBG_API_BASE=https://api.gbgplc.com

# GBG API token (Bearer). Obtain from your GBG GO admin console.
GBG_API_TOKEN=

# GBG journey / profile ID — identifies which verification journey to run.
GBG_JOURNEY_ID=

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
