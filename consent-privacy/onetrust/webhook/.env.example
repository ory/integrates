# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Shared secret between OneTrust's DSR workflow and this handler
# (X-OneTrust-Secret header value). Distinct from ORY_WEBHOOK_SECRET so a leak
# of one credential can't be used to call the other surface.
ONETRUST_DSR_SECRET=

# OneTrust API host (default app.onetrust.com; EU tenants use eu.onetrust.com).
ONETRUST_HOST=app.onetrust.com

# OneTrust OAuth2 client credentials (Admin -> Profile -> Credentials).
ONETRUST_CLIENT_ID=
ONETRUST_CLIENT_SECRET=

# OneTrust Purpose IDs to map our consent category names to.
# Leave any of these unset to skip that category in the consent receipt.
ONETRUST_PURPOSE_MARKETING=
ONETRUST_PURPOSE_ANALYTICS=
ONETRUST_PURPOSE_FUNCTIONAL=
ONETRUST_PURPOSE_ESSENTIAL=
ONETRUST_PURPOSE_PERSONALIZATION=

# Ory Network SDK URL (e.g. https://<project-slug>.projects.oryapis.com).
ORY_SDK_URL=

# Ory admin API key with identity read/write/delete scope (for DSR fulfillment).
ORY_ADMIN_API_KEY=

# Port the handler listens on.
PORT=3000
