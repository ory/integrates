# Meta Graph API version. Pin to a known-good version; bump after testing.
WHATSAPP_GRAPH_VERSION=v22.0

# WhatsApp Business phone number ID — from Meta for Developers → WhatsApp → API Setup.
# This is NOT the phone number itself; it's the numeric ID Meta assigns to it.
WHATSAPP_PHONE_NUMBER_ID=

# Permanent system-user access token for the WhatsApp Business app.
# Generate via Meta Business Manager → System Users → Add Asset → WhatsApp Business Account.
WHATSAPP_ACCESS_TOKEN=

# Pre-approved AUTHENTICATION-category template name (must be approved in Meta Business Manager).
# Default name suggestion: ory_otp. Single body parameter {{1}} = the OTP code.
WHATSAPP_OTP_TEMPLATE=ory_otp

# Template language code (must match what was approved). e.g. en_US, en, de, es_ES.
WHATSAPP_OTP_TEMPLATE_LANG=en_US

# Shared secret with Ory's courier configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Port the handler listens on.
PORT=3000
