# Basic Auth credentials. Must match the user:password embedded in the
# Ory Network event-stream target URL configured for this integration.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Vendor API base URL and bearer token (rename / add as needed).
VENDOR_API_BASE=https://api.example.com
VENDOR_API_TOKEN=

# Port the handler listens on.
PORT=3000
