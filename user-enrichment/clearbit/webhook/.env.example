# DEPRECATED — Clearbit standalone API access is closed to new customers
# after HubSpot's acquisition. This handler is kept for legacy contracts only.
# For new deployments, see user-enrichment/fullcontact or user-enrichment/zoominfo.

# Shared secret with Ory's webhook configuration (X-Webhook-Secret header value).
ORY_WEBHOOK_SECRET=

# Clearbit API key (Clearbit dashboard -> API).
CLEARBIT_API_KEY=

# Clearbit API base. Override only for testing.
CLEARBIT_API_BASE=https://person-stream.clearbit.com

# Ory Network SDK URL (e.g. https://<project-slug>.projects.oryapis.com).
ORY_SDK_URL=

# Ory admin API key with identity read/write scope (Ory Console -> API Keys).
ORY_ADMIN_API_KEY=

# Port the handler listens on.
PORT=3000
